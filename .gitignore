# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 笔记运行时产物（保留示例笔记）
backend/notebooks/*
!backend/notebooks/示例笔记.md
# AI 聊天记录（与笔记同名派生文件，永不入库；上面已覆盖，显式声明意图）
*.ai-chat.json

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# 环境变量（勿把密钥提交进仓库）
.env

# 执行器临时工作目录（EXEC_TMP_DIR）
exec-tmp/
.tmp/

# 项目内依赖目录（pip --target .deps 产物）
backend/.deps/

# 打包产物与中间物（PyInstaller / 发布 zip）
build/
dist/
frontend/vendor/

# 前端工程（Vite）
node_modules/
frontend/dist/
frontend/.vite/

# Whoosh 全文检索索引（运行时生成）
backend/.search_index/
.search_index/
